<?xml version="1.0" encoding="utf-8"?>

<RunSettings>

  <DataCollectionRunSettings>

    <DataCollectors>

      <DataCollector friendlyName="XPlat Code Coverage">

        <Configuration>

          <Format>cobertura</Format>

          <ExcludeByFile>
            **/Program.cs;
            **/Migrations/**/*.cs;
            **/Endpoints/**/*.cs;
            **/Dtos/**/*.cs;
            **/Entities/**/*.cs;
            **/*.g.cs;
            **/*.generated.cs
          </ExcludeByFile>

        </Configuration>

      </DataCollector>

    </DataCollectors>

  </DataCollectionRunSettings>

</RunSettings>